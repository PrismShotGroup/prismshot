{
  "name": "prismshot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run images:build",
    "dev": "next dev",
    "prebuild": "npm run images:build && npm run content:validate",
    "build": "next build",
    "postbuild": "tsx scripts/finalize-static-export.ts",
    "images:build": "tsx scripts/process-images.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "test:smoke": "node scripts/smoke-browser.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "playwright-core": "^1.62.1",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
